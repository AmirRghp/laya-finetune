# Copy to .env and adjust. Every value here is optional: each one overrides the
# matching key in configs/default.yaml, which is where the real defaults live.
#
# Nothing secret is required by this pipeline. Laya checkpoints are public and
# Ollama is a local HTTP server, so no API token is needed anywhere.

# --- Ollama -----------------------------------------------------------------
# Base URL of the Ollama HTTP API. Must include the scheme.
LAYA_OLLAMA_ENDPOINT=http://127.0.0.1:11434

# Model used to generate Persian questions. Any model Ollama can serve works;
# pick one with good Persian instruction following.
LAYA_OLLAMA_GENERATION_MODEL=qwen2.5:7b-instruct

# Model used to embed chunks and queries for hard-negative mining.
LAYA_OLLAMA_EMBEDDING_MODEL=bge-m3

# Model used to label and verify. May be the same as the generation model.
LAYA_OLLAMA_TEACHER_MODEL=qwen2.5:7b-instruct

# Context window passed to the model. Raise it if a long chunk overflows.
LAYA_OLLAMA_NUM_CTX=8192

# Disable the model's reasoning mode. Required for Qwen3-family models on this
# pipeline's extraction prompts: with thinking on, a small model can spend its
# whole context budget deliberating and return an empty answer.
# Set to "true" or "null" to change it.
LAYA_OLLAMA_THINK=false

# --- Pipeline ---------------------------------------------------------------
# Overrides configs/default.yaml. Relative paths resolve against the repo root.
LAYA_CORPUS_DIR=corpus
LAYA_OUTPUT_DIR=outputs

# --- Hugging Face -----------------------------------------------------------
# Optional token, only needed for private mirrors or rate-limit headroom.
# HF_TOKEN=hf_xxx